{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/lumnia-mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://nvskvrgsfzaynotdgzoy.supabase.co/auth/v1",
    "require_oauth_client_claim": false,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "lumnia-mcp",
      "version": "0.5.1",
      "title": "Lumnia"
    },
    "tools": [
      {
        "name": "search",
        "title": "Buscar transações",
        "description": "Busca transações (despesas e receitas) do usuário autenticado por texto livre na descrição, categoria ou mês (YYYY-MM). Retorna uma lista de resultados com id, título e resumo para depois usar a ferramenta fetch.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Termo de busca: descrição, categoria ou mês no formato YYYY-MM."
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "fetch",
        "title": "Abrir transação",
        "description": "Retorna todos os detalhes de uma transação do usuário autenticado a partir do id devolvido pela ferramenta search.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "ID da transação (uuid)."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "Listar transações",
        "description": "Lista despesas e receitas do usuário autenticado em um intervalo de datas (padrão: últimos 30 dias). Retorna id, data, descrição, valor, tipo, categoria, se está paga e forma de pagamento.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "start_date": {
              "description": "Data inicial ISO (YYYY-MM-DD). Padrão: 30 dias atrás.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "end_date": {
              "description": "Data final ISO (YYYY-MM-DD). Padrão: hoje.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "type": {
              "description": "Filtrar por tipo.",
              "type": "string",
              "enum": [
                "income",
                "expense",
                "transfer"
              ]
            },
            "limit": {
              "description": "Máximo de registros (padrão 100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_transaction",
        "title": "Criar transação",
        "description": "Cria uma despesa ou receita. Aceita conta/carteira (nome ou id), cartão de crédito, forma de pagamento, recorrência fixa mensal/anual, parcelamento, projeto, tags e observação. Sem carteira informada, usa a carteira padrão do usuário. Para despesas no cartão, o mês da fatura é calculado automaticamente pelo fechamento do cartão.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Descrição curta da transação."
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Valor absoluto (positivo) em BRL. Em parcelamentos, é o valor total."
            },
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data ISO YYYY-MM-DD."
            },
            "type": {
              "type": "string",
              "enum": [
                "expense",
                "income"
              ],
              "description": "expense = despesa, income = receita."
            },
            "category": {
              "description": "Nome da categoria.",
              "type": "string"
            },
            "category_id": {
              "description": "ID da categoria (preferencial).",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "wallet": {
              "description": "Nome da conta/carteira.",
              "type": "string"
            },
            "wallet_id": {
              "description": "ID da conta/carteira.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "credit_card": {
              "description": "Nome do cartão de crédito (para compras no crédito).",
              "type": "string"
            },
            "credit_card_id": {
              "description": "ID do cartão de crédito.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "invoice_month": {
              "description": "Mês da fatura (YYYY-MM). Se omitido, é calculado pelo fechamento do cartão.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$"
            },
            "payment_method": {
              "description": "Forma de pagamento (ex: pix, debito, credito, dinheiro).",
              "type": "string"
            },
            "is_paid": {
              "description": "Se já foi pago/recebido. Padrão: true.",
              "type": "boolean"
            },
            "is_recurring": {
              "description": "Despesa/receita fixa que se repete.",
              "type": "boolean"
            },
            "frequency": {
              "description": "Frequência da recorrência. Padrão: monthly.",
              "type": "string",
              "enum": [
                "monthly",
                "yearly"
              ]
            },
            "installments": {
              "description": "Número de parcelas. Acima de 1, cria uma parcela por mês dividindo o valor total.",
              "type": "integer",
              "minimum": 1,
              "maximum": 360
            },
            "project": {
              "description": "Nome do projeto/centro de custo.",
              "type": "string"
            },
            "project_id": {
              "description": "ID do projeto.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "tags": {
              "description": "Etiquetas livres.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "notes": {
              "description": "Observações.",
              "type": "string"
            }
          },
          "required": [
            "description",
            "value",
            "date",
            "type"
          ]
        },
        "outputSchema": null
      },
      {
