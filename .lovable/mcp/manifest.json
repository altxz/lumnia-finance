                "create",
                "update",
                "delete"
              ],
              "description": "create, update ou delete."
            },
            "category": {
              "description": "Nome da categoria a editar ou excluir.",
              "type": "string"
            },
            "category_id": {
              "description": "ID da categoria a editar ou excluir.",
