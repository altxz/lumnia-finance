{
  "version": 1,
  "sdk_version": "0.26.2",
  "path": "/functions/v1/lumnia-mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://nvskvrgsfzaynotdgzoy.supabase.co/auth/v1",
    "require_oauth_client_claim": false,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "lumnia-mcp",
      "version": "0.4.0",
      "title": "Lumnia"
    },
    "tools": [
      {
        "name": "search",
        "title": "Buscar transações",
        "description": "Busca transações (despesas e receitas) do usuário autenticado por texto livre na descrição, categoria ou mês (YYYY-MM). Retorna uma lista de resultados com id, título e resumo para depois usar a ferramenta fetch.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Termo de busca: descrição, categoria ou mês no formato YYYY-MM."
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "fetch",
        "title": "Abrir transação",
        "description": "Retorna todos os detalhes de uma transação do usuário autenticado a partir do id devolvido pela ferramenta search.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "ID da transação (uuid)."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_transactions",
        "title": "Listar transações",
        "description": "Lista despesas e receitas do usuário autenticado em um intervalo de datas (padrão: últimos 30 dias). Retorna id, data, descrição, valor, tipo, categoria, se está paga e forma de pagamento.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "start_date": {
              "description": "Data inicial ISO (YYYY-MM-DD). Padrão: 30 dias atrás.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "end_date": {
              "description": "Data final ISO (YYYY-MM-DD). Padrão: hoje.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "type": {
              "description": "Filtrar por tipo.",
              "type": "string",
              "enum": [
                "income",
                "expense",
                "transfer"
              ]
            },
            "limit": {
              "description": "Máximo de registros (padrão 100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_transaction",
        "title": "Criar transação",
        "description": "Cria uma nova despesa ou receita para o usuário autenticado. Use tipo 'expense' para despesa e 'income' para receita.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "Descrição curta da transação."
            },
            "value": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "Valor absoluto (positivo) em BRL."
            },
            "date": {
              "type": "string",
              "description": "Data ISO YYYY-MM-DD."
            },
            "type": {
              "type": "string",
              "enum": [
                "expense",
                "income"
              ],
              "description": "Tipo da transação."
            },
            "category": {
              "description": "Nome/slug da categoria final.",
              "type": "string"
            },
            "is_paid": {
              "description": "Se já foi pago/recebido. Padrão: true.",
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "description",
            "value",
            "date",
            "type"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_categories",
        "title": "Listar categorias",
        "description": "Lista todas as categorias e subcategorias do usuário autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "month_summary",
        "title": "Resumo do mês",
        "description": "Resume receitas, despesas e saldo do mês (YYYY-MM) usando exatamente o mesmo motor de projeção das páginas do app: saldo inicial (fim do mês anterior), receitas e despesas previstas (incluindo não pagas, recorrentes projetadas e faturas de cartão) e saldo previsto do fim do mês. Também informa os valores já realizados (pagos).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "month": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "description": "Mês no formato YYYY-MM."
            }
          },
          "required": [
            "month"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_wallets",
        "title": "Listar carteiras",
        "description": "Lista carteiras e ativos do usuário com saldo atual e moeda.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_credit_cards",
        "title": "Listar cartões de crédito",
        "description": "Lista cartões de crédito do usuário com limite, dia de fechamento e vencimento.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "month_transactions",
        "title": "Transações do mês com saldo projetado",
        "description": "Retorna a mesma visão da página de Transações de um mês (YYYY-MM): todas as transações do mês (incluindo recorrentes projetadas e pagamentos de fatura de cartão), agrupadas por dia, com o saldo projetado acumulado ao final de cada dia, além do saldo inicial e do saldo previsto do fim do mês.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "month": {
              "type": "string",
              "description": "Mês no formato YYYY-MM."
            }
          },
          "required": [
            "month"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "delete_transaction",
        "title": "Excluir transação",
        "description": "Exclui uma transação (despesa ou receita) do usuário autenticado pelo id. Para parcelamentos, use scope='group' para remover todas as parcelas do mesmo grupo. Ação irreversível: confirme com o usuário antes de chamar.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "ID da transação a excluir."
            },
            "scope": {
              "description": "'single' (padrão) remove apenas esta transação; 'group' remove todas as parcelas do mesmo installment_group_id.",
              "type": "string",
              "enum": [
                "single",
                "group"
              ]
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
